{
  "platforms": ["cursor", "claude", "copilot", "claude-marketplace"],
  "marketplace": {
    "plugins": [
      {
        "name": "frontend",
        "displayName": "Frontend Developer",
        "description": "Skills and agents for React/TypeScript frontend projects",
        "profiles": ["frontend"]
      },
      {
        "name": "fullstack",
        "displayName": "Full-Stack Developer",
        "description": "Skills and agents for full-stack projects (frontend + backend)",
        "profiles": ["frontend", "backend", "fullstack"]
      },
      {
        "name": "backend",
        "displayName": "Backend Developer",
        "description": "Skills and agents for API, database, and service projects",
        "profiles": ["backend"]
      },
      {
        "name": "devops",
        "displayName": "DevOps / Platform Engineer",
        "description": "Skills and agents for CI/CD, containers, and infrastructure",
        "profiles": ["devops", "pure-infra"]
      }
    ]
  },
  "source": "llm",
  "targets": {
    "rules": {
      "cursor": { "dir": ".cursor/rules", "ext": ".mdc" },
      "claude": { "dir": ".claude/rules", "ext": ".md" },
      "copilot": { "dir": ".github/instructions", "ext": ".instructions.md" }
    },
    "agents": {
      "cursor": { "dir": ".cursor/agents", "ext": ".md" },
      "claude": { "dir": ".claude/agents", "ext": ".md" },
      "copilot": { "dir": ".github/agents", "ext": ".agent.md" }
    },
    "skills": {
      "cursor": { "dir": ".cursor/skills" },
      "claude": { "dir": ".claude/skills" },
      "copilot": { "dir": ".github/skills" }
    }
  }
}
