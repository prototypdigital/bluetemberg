{
  "name": "@prototypdigital/bluetemberg",
  "version": "0.1.3",
  "description": "Scaffold vendor-neutral AI tooling (rules, agents, skills) with cross-platform sync for Cursor, Claude, and GitHub Copilot.",
  "type": "module",
  "bin": {
    "bluetemberg": "./bin/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./sync": "./dist/sync/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prototypdigital/bluetemberg.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sync:llm-config": "node bin/cli.js sync",
    "sync:llm-config:check": "node bin/cli.js sync --check",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "cursor",
    "claude",
    "copilot",
    "scaffolding",
    "cli"
  ],
  "author": "Prototyp Digital",
  "license": "UNLICENSED",
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "commander": "^13.0.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/"
  ]
}
