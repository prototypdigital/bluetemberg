{
  "name": "bluetemberg",
  "version": "0.10.0",
  "description": "Author AI coding rules, agents, and skills once — sync version-locked, integrity-verified config to Cursor, Claude Code, GitHub Copilot, Gemini CLI, Windsurf, and OpenAI Codex.",
  "type": "module",
  "bin": {
    "bluetemberg": "./bin/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./sync": "./dist/sync/index.js",
    "./sync/pipeline": "./dist/sync/pipeline.js",
    "./sync/adapter-contract": "./dist/sync/adapter-contract.js",
    "./registry": "./dist/registry/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prototypdigital/bluetemberg.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "node scripts/copy-assets.mjs && tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sync:llm-config": "node bin/cli.js sync",
    "sync:llm-config:check": "node bin/cli.js sync --check",
    "build:site": "node scripts/build-site.js",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "check:overlays": "node scripts/check-overlays.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "cursor",
    "claude",
    "copilot",
    "gemini",
    "windsurf",
    "codex",
    "agents",
    "skills",
    "scaffolding",
    "cli"
  ],
  "author": "Prototyp Digital",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "semver": "^7.7.4",
    "smol-toml": "^1.6.1",
    "tar": "^7.5.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "eslint": "^10.2.1",
    "prettier": "^3.8.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin/",
    "dist/"
  ]
}
