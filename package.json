{
  "name": "bluetemberg",
  "version": "0.3.0",
  "description": "Scaffold vendor-neutral AI tooling (rules, agents, skills) with cross-platform sync for Cursor, Claude, and GitHub Copilot.",
  "type": "module",
  "bin": {
    "bluetemberg": "./bin/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./sync": "./dist/sync/index.js",
    "./sync/pipeline": "./dist/sync/pipeline.js",
    "./sync/adapter-contract": "./dist/sync/adapter-contract.js",
    "./registry": "./dist/registry/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prototypdigital/bluetemberg.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "sync:llm-config": "node bin/cli.js sync",
    "sync:llm-config:check": "node bin/cli.js sync --check",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "llm",
    "cursor",
    "claude",
    "copilot",
    "scaffolding",
    "cli"
  ],
  "author": "Prototyp Digital",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "semver": "^7.7.4",
    "tar": "^7.5.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "eslint": "^9.0.0",
    "prettier": "^3.8.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin/",
    "dist/"
  ]
}
